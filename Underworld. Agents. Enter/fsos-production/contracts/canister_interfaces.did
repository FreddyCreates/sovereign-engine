// Freight Sovereign OS canister interface draft.
// This is a production seed contract boundary, not a deployed canister.

type CarrierId = text;
type LoadId = text;
type DriverId = text;
type ShipperId = text;

type ComplianceIssue = record {
  code : text;
  message : text;
  severity : text;
  reference : opt text;
};

type ComplianceDecision = record {
  allowed : bool;
  issues : vec ComplianceIssue;
  warnings : vec ComplianceIssue;
};

type MatchResult = record {
  load_id : LoadId;
  carrier_id : CarrierId;
  score : text;
  allowed : bool;
  reasons : vec text;
};

service : {
  register_carrier : (text) -> (CarrierId);
  verify_carrier_authority : (CarrierId) -> (ComplianceDecision);
  post_load : (text) -> (LoadId);
  evaluate_load_access : (CarrierId, DriverId, LoadId) -> (ComplianceDecision);
  match_load : (LoadId) -> (vec MatchResult);
  create_settlement_preview : (LoadId, text) -> (text);
  append_audit_event : (text, text) -> (text);
  verify_audit_chain : () -> (bool);
}

