---
import JournalLayout from '../layouts/JournalLayout.astro';
import { entries } from '../lib/lexicon.js';

// Group by first letter for alphabetic navigation.
const groups = new Map();
for (const e of entries) {
  const letter = e.term[0].toUpperCase();
  if (!groups.has(letter)) groups.set(letter, []);
  groups.get(letter).push(e);
}
const letters = [...groups.keys()].sort();
---
<JournalLayout
  title="The Lexicon — The Journal"
  description="Every Latin and Greek term in the work, its root, its mathematical or biological identity, its place in the system."
  eyebrow="§ III — The Lexicon"
>
  <header class="measure stack" style="margin-top: var(--s-4);">
    <h1>The Lexicon</h1>
    <p class="muted" style="font-size: var(--t-h5); line-height: 1.5;">
      Every Latin term. Its root. Its mathematical identity.
      Its place in the architecture.
    </p>
    <p>
      Inclusion rule: a term appears here only if it is named in a public
      paper <em>and</em> its mathematical or biological identity can be cited.
      Internal codenames without a public paper are not in this lexicon.
    </p>
  </header>

  <hr class="rule" />

  <nav aria-label="alphabetical jump" style="margin-bottom: var(--s-5);">
    {letters.map(L => (
      <a href={`#L-${L}`} class="pill no-underline">{L}</a>
    ))}
  </nav>

  <table>
    <thead>
      <tr>
        <th style="width: 22%;">Term</th>
        <th style="width: 28%;">Root</th>
        <th style="width: 50%;">Role / what it does</th>
      </tr>
    </thead>
    <tbody>
      {letters.map(L => (
        <>
          <tr id={`L-${L}`}>
            <td colspan="3" style="background: var(--c-paper-2); padding-top: var(--s-4); padding-bottom: var(--s-2);">
              <span class="eyebrow">{L}</span>
            </td>
          </tr>
          {groups.get(L).map(e => (
            <tr>
              <td><strong class="latin">{e.term}</strong></td>
              <td class="muted small">{e.root}</td>
              <td>
                <em>{e.role}</em>
                <div style="margin-top: var(--s-2);" class="small">{e.note}</div>
              </td>
            </tr>
          ))}
        </>
      ))}
    </tbody>
  </table>

  <hr class="rule" />

  <p class="small muted" style="text-align: center;">
    If a term is missing — write to <a href="mailto:Medinasitech@outlook.com">Medinasitech@outlook.com</a>.
    The lexicon grows as the papers do.
  </p>
</JournalLayout>
