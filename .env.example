# Sovereign Books MVP — copy to .env and fill in

# Database (SQLite by default; set DATABASE_URL for Postgres later)
SOVEREIGN_BOOKS_DB=data/sovereign_books.db

# Plaid sandbox — leave blank to use local mock bank (demo mode)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

# Demo user / business (auto-created on first request)
SOVEREIGN_DEMO_EMAIL=owner@sovereign.local
SOVEREIGN_DEMO_BUSINESS="Sovereign Demo Co"

# RevenueCat — leave blank to use local entitlements + scripts/activate_pro.py
REVENUECAT_SECRET_API_KEY=
REVENUECAT_APP_USER_ID=books_demo_user
REVENUECAT_ENTITLEMENT_ID=pro_access
REVENUECAT_WEBHOOK_AUTH=
# Public SDK key belongs in the mobile app (Android RevenueCatManager), not the server.

# Optional LLM polish for books chat (script engine always works without these)
GEMINI_API_KEY=
OPENAI_API_KEY=
